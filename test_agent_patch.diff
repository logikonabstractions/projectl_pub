+def load_cards_from_yaml(filepath, piece_lookup=None):
+    """Load card definitions from a cards_list.yaml file.
+
+    Supports the canonical cards_list.yaml schema:
+      {id, name, rewards: {points, piece (ID string)}, matrix (5x5 ints)}
+
+    The piece ID in rewards (e.g. "P1") is resolved to a real Piece object
+    using the provided piece_lookup dict. If not resolvable, falls back to
+    the default PieceSquare.
+
+    Args:
+        filepath: Path to the YAML file containing card definitions.
+        piece_lookup: dict mapping piece_id -> Piece prototype (e.g. {"P1": Piece(...)}).
+                      If None, reward pieces default to PieceSquare.
+
+    Returns:
+        list of Card objects.
+    """
+    with open(filepath, 'r') as f:
+        data = yaml.safe_load(f)
+
+    cards = []
+    for c_raw in data["cards"]:
+        # Resolve piece reference
+        piece_id = None
+        reward_conf = c_raw.get("rewards", c_raw.get("reward", {}))
+        if reward_conf:
+            piece_id = reward_conf.get("piece")
+
+        piece = None
+        if piece_id and piece_lookup:
+            piece = piece_lookup.get(piece_id)
+
+        # Build the Card using the production Card constructor
+        card_config = {
+            "mask": [[bool(v) for v in row] for row in c_raw["matrix"]],
+            "reward": {
+                "points": reward_conf.get("points", 0) if reward_conf else 0,
+                "piece": piece,
+            }
+        }
+        card = Card(configs=card_config)
+        cards.append(card)
+
+    return cards
