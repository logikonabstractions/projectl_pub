+def _pad_to_5x5(matrix):
+    """Place an arbitrary (<=5x5) int matrix into the top-left of a 5x5 grid."""
+    grid = np.zeros((5, 5), dtype=int)
+    src = np.array(matrix, dtype=int)
+    grid[:src.shape[0], :src.shape[1]] = src
+    return grid.tolist()
+
+
+def load_pieces_from_yaml(filepath, default_quantity=10):
+    """Load piece definitions from a pieces_list.yaml file.
+
+    Supports the canonical pieces_list.yaml schema:
+      {id, name, cells, matrix (<=4x4 ints)}
+
+    Also supports the legacy configs.yaml schema:
+      {name, level, quantity, shape (5x5 ints)}
+
+    Args:
+        filepath: Path to the YAML file containing piece definitions.
+        default_quantity: Default number of pieces per type if not specified.
+
+    Returns:
+        tuple: (piece_lookup, piece_bank)
+            piece_lookup: dict mapping piece_id -> Piece prototype (e.g., {"P1": Piece(monomino)})
+            piece_bank:   dict mapping piece_name -> list of Piece instances (e.g., {"monomino": [...]})
+    """
+    with open(filepath, 'r') as f:
+        data = yaml.safe_load(f)
+
+    piece_lookup = {}   # id -> Piece prototype
+    piece_bank = {}     # name -> [Piece instances]
+
+    for p_raw in data["pieces"]:
+        # Normalise to the Piece constructor's expected schema
+        if "matrix" in p_raw:
+            # New canonical format
+            normalized = {
+                "id":    p_raw["id"],
+                "name":  p_raw["name"],
+                "level": p_raw.get("level", p_raw.get("cells", 1)),
+                "cells": p_raw.get("cells", 1),
+                "shape": _pad_to_5x5(p_raw["matrix"]),
+            }
+        else:
+            # Legacy format (shape already 5x5)
+            normalized = {
+                "id":    p_raw.get("id", p_raw["name"]),
+                "name":  p_raw["name"],
+                "level": p_raw.get("level", 1),
+                "cells": p_raw.get("cells", p_raw.get("level", 1)),
+                "shape": p_raw["shape"],
+            }
+
+        piece_id = normalized["id"]
+        piece_name = normalized["name"]
+        quantity = p_raw.get("quantity", default_quantity)
+
+        # One prototype for ID-based lookup (e.g., resolving card rewards)
+        prototype = Piece(configs=normalized)
+        piece_lookup[piece_id] = prototype
+
+        # Multiple copies for the bank
+        piece_bank[piece_name] = [Piece(configs=normalized) for _ in range(quantity)]
+
+    return piece_lookup, piece_bank
